/* Modern Datasheet Studio Style */

/* Main Window */
QMainWindow {
    background-color: #f0f0f0;
}

/* Panels */
QFrame#document_viewer_panel,
QFrame#bookmarks_library_panel,
QFrame#selected_pages_panel,
QFrame#ai_panel {
    background-color: white;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    padding: 8px;
}

/* Panel Titles */
QLabel#panel_title {
    font-size: 16px;
    font-weight: bold;
    color: #2c3e50;
    padding: 4px 0px;
}

/* Buttons */
QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: 500;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #21618c;
}

QPushButton:disabled {
    background-color: #bdc3c7;
    color: #7f8c8d;
}

/* Zoom and Navigation Buttons */
QPushButton#zoom_button {
    background-color: #2ecc71;
}

QPushButton#zoom_button:hover {
    background-color: #27ae60;
}

QPushButton#nav_button {
    background-color: #9b59b6;
}

QPushButton#nav_button:hover {
    background-color: #8e44ad;
}

/* Scroll Area */
QScrollArea {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    background-color: #fafafa;
}

/* Tree Widget (Bookmarks) */
QTreeWidget {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    alternate-background-color: #f9f9f9;
}

QTreeWidget::item {
    padding: 4px;
}

QTreeWidget::item:selected {
    background-color: #3498db;
    color: white;
}

/* List Widget (Selected Pages) */
QListWidget {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    alternate-background-color: #f9f9f9;
}

QListWidget::item {
    padding: 6px;
    border-bottom: 1px solid #eee;
}

QListWidget::item:selected {
    background-color: #3498db;
    color: white;
}

/* Line Edit */
QLineEdit {
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 4px;
    background-color: white;
}

QLineEdit:focus {
    border: 2px solid #3498db;
}

/* Combo Box */
QComboBox {
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 4px;
    background-color: white;
}

QComboBox:focus {
    border: 2px solid #3498db;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #ccc;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #ecf0f1;
    color: #2c3e50;
    padding: 6px 12px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #3498db;
    color: white;
}

/* Menu */
QMenuBar {
    background-color: #2c3e50;
    color: white;
    spacing: 3px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background: #34495e;
}

QMenuBar::item:pressed {
    background: #3d566e;
}

QMenu {
    background-color: white;
    border: 1px solid #ccc;
    color: #2c3e50;
}

QMenu::item {
    padding: 6px 20px;
}

QMenu::item:selected {
    background-color: #3498db;
    color: white;
}

/* Status Bar */
QStatusBar {
    background-color: #34495e;
    color: white;
    border-top: 1px solid #2c3e50;
}

/* Dialog */
QDialog {
    background-color: #f5f5f5;
}

/* Text Edit */
QTextEdit {
    border: 1px solid #ccc;
    border-radius: 4px;
    background-color: white;
}

/* Note Editor Dialog */
QDialog QLabel {
    color: #2c3e50;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #ddd;
    border-radius: 4px;
    margin-top: 1ex;
    padding-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
}